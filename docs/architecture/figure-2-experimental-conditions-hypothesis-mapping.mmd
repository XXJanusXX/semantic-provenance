%% Figure 2 — LENS Experimental Conditions and Hypothesis Mapping
%% Recommended export: A4 landscape, SVG or PDF.
%%{init: {
  "theme": "base",
  "flowchart": {
    "htmlLabels": true,
    "curve": "basis",
    "nodeSpacing": 28,
    "rankSpacing": 38,
    "padding": 12
  },
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "13px",
    "lineColor": "#526579",
    "primaryTextColor": "#172B4D"
  }
}}%%

flowchart TB
    SOURCE["BENCHMARK INPUT<br/>Source Information · Task Requirements<br/>Semantic Invariants · Independent Ground Truth"]

    subgraph CONDITIONS["CONTROLLED EXPERIMENTAL CONDITIONS"]
        direction LR
        B0["B0 — Deterministic / Direct<br/>Reference Condition"]
        B1["B1 — Ollama-Mediated<br/>Direct Transformation"]
        B2["B2 — Semantic / Ontology<br/>Mediated Transformation"]
        B3["B3 — Ollama + LENS<br/>Contract + Semantic Validation"]
        B4["B4 — B3 + Conventional<br/>Provenance and Integrity"]
        B5["B5 — B4 + DLT<br/>Optional / Deferred"]
        B0 ~~~ B1
        B1 ~~~ B2
        B2 ~~~ B3
        B3 --> B4
        B4 -. Optional extension .-> B5
    end

    SOURCE --> B0
    SOURCE --> B1
    SOURCE --> B2
    SOURCE --> B3

    subgraph HYPOTHESES["HYPOTHESIS EVALUATION"]
        direction LR
        subgraph PRIMARY["PRIMARY HYPOTHESIS"]
            H1["H1 — PRIMARY<br/>B3 versus B1<br/>Semantic Fidelity (SF)<br/>Expected improvement"]
        end
        subgraph SECONDARY["SECONDARY HYPOTHESES"]
            H2["H2 — SECONDARY<br/>B3 versus B1<br/>Reconciliation Failure Rate (RFR)<br/>Expected reduction"]
            H3["H3 — SECONDARY<br/>Detector versus Independent Ground Truth<br/>Detection Performance<br/>Positive Semantic-Loss Cases"]
            H4["H4 — SECONDARY<br/>B4 versus B3<br/>Provenance Continuity (PC)<br/>Expected improvement"]
        end
    end

    B1 --> H1
    B3 --> H1
    B1 --> H2
    B3 --> H2
    B3 --> H3
    B3 --> H4
    B4 --> H4

    subgraph EVIDENCE["EVIDENCE AND RECONCILIATION"]
        direction LR
        CAPTURE["Execution Evidence<br/>Source Revision · Model<br/>Configuration · Dependencies<br/>Run Manifest · Logs"]
        METRICS["Metric Calculation<br/>SF · RFR · Detection Performance · PC"]
        STATS["Statistical Analysis<br/>Prespecified Tests<br/>Effect Sizes · Confidence Intervals"]
        REVIEW["Independent Review<br/>Case-Level Reconciliation<br/>Deviations · Missing / Unknown Outcomes"]
        CAPTURE --> METRICS --> STATS --> REVIEW
    end

    H1 --> CAPTURE
    H2 --> CAPTURE
    H3 --> CAPTURE
    H4 --> CAPTURE

    REVIEW --> OUT["RESEARCH FINDINGS<br/>Hypothesis Decisions · Reproducibility<br/>Reliability · Limitations · Boundary Conditions"]

    classDef source fill:#E9EEF5,stroke:#526579,color:#172B4D,stroke-width:1.5px
    classDef condition fill:#E8F1FB,stroke:#3973AC,color:#17365D,stroke-width:1.3px
    classDef primary fill:#E2F0E5,stroke:#287A43,color:#174B2D,stroke-width:2px
    classDef secondary fill:#FFF2DF,stroke:#BD812C,color:#68420C,stroke-width:1.3px
    classDef evidence fill:#F0EAFA,stroke:#8061A8,color:#422D61,stroke-width:1.3px
    classDef output fill:#E3EDF0,stroke:#426D7B,color:#173D49,stroke-width:1.8px

    class SOURCE source
    class B0,B1,B2,B3,B4,B5 condition
    class H1 primary
    class H2,H3,H4 secondary
    class CAPTURE,METRICS,STATS,REVIEW evidence
    class OUT output

    style CONDITIONS fill:#F7F9FC,stroke:#8295A8,stroke-width:1.5px
    style HYPOTHESES fill:#FFFFFF,stroke:#526579,stroke-width:1.5px
    style PRIMARY fill:#F0F8F2,stroke:#287A43,stroke-width:1.5px
    style SECONDARY fill:#FFFAF1,stroke:#BD812C,stroke-width:1.5px
    style EVIDENCE fill:#F8F5FC,stroke:#8061A8,stroke-width:1.5px
